# Base de datos Postgres (Supabase, Neon, Railway o instancia propia)
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Secreto para firmar sesiones JWT — genera uno fuerte con: openssl rand -base64 32
SESSION_SECRET="change-me"

# Vercel Blob — requerido en producción para subir imágenes
# (en Vercel el disco es de solo lectura; sin este token /api/upload falla con 500)
# Vercel → Storage → Create Blob Store → copiar BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=""

# Almacenamiento alternativo (opcional)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ACCOUNT_ID=""

# WhatsApp Business API (para notificación de nuevas órdenes)
WHATSAPP_BUSINESS_PHONE_NUMBER=""
WHATSAPP_API_TOKEN=""
