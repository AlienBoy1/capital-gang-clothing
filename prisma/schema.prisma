// ============================================================================
// CAPITAL GANG CLOTHING — Data Model
// Bounded contexts: Identity | Catalog | TattooShop | Gallery | Orders | AI Product Studio
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------
// IDENTITY CONTEXT
// ------------------------------------------------------------------

enum Role {
  ADMIN
  USER
}

model User {
  id             String    @id @default(cuid())
  firstName      String
  lastName       String
  phone          String
  email          String?   @unique
  passwordHash   String
  role           Role      @default(USER)

  // Access-code validation flow (only relevant for USER on first login)
  accessCode      String?   // hashed, used to verify first login
  /// Plaintext code for admin panel until the user finishes first login + password setup
  accessCodePlain String?
  isValidated     Boolean   @default(false)
  /// After first login with access code, user must set their own password
  mustSetPassword Boolean   @default(false)

  isActive       Boolean   @default(true)
  avatarUrl      String?
  locale         String    @default("es-MX")
  theme          String    @default("dark")

  createdById    String?
  createdBy      User?     @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers   User[]    @relation("UserCreatedBy")

  sessions       Session[]
  activityLogs   ActivityLog[]
  createdProducts Product[] @relation("ProductCreatedBy")
  handledOrders  OrderNote[]
  aiProjects           AIProject[]            @relation("AIProjectCreatedBy")
  aiAssetVersions      AIAssetVersion[]       @relation("AIAssetVersionCreatedBy")
  catalogPublications  CatalogPublication[]   @relation("CatalogPublicationBy")
  catalogPublishSessions CatalogPublishSession[] @relation("CatalogPublishSessionBy")

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([role])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   // e.g. "product.created", "order.status_changed"
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("activity_logs")
}

// ------------------------------------------------------------------
// SHARED CATALOG PRIMITIVES (used by both Clothing & TattooShop)
// ------------------------------------------------------------------

enum StoreType {
  CLOTHING
  TATTOO_SHOP
}

model Category {
  id           String     @id @default(cuid())
  storeType    StoreType
  name         String
  slug         String
  parentId     String?
  parent       Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  subcategories Category[] @relation("CategoryParent")
  products     Product[]
  order        Int        @default(0)

  @@unique([storeType, slug])
  @@map("categories")
}

model Collection {
  id          String    @id @default(cuid())
  storeType   StoreType
  name        String
  slug        String    @unique
  description String?
  coverImage  String?
  isDrop      Boolean   @default(false)
  dropDate    DateTime?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())

  @@map("collections")
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("app_settings")
}

model Product {
  id            String       @id @default(cuid())
  storeType     StoreType
  name          String
  slug          String
  description   String
  basePrice     Decimal      @db.Decimal(10, 2)
  discountPrice Decimal?     @db.Decimal(10, 2)
  /// Available units for sale (decremented when an order is marked as SALE)
  stock         Int          @default(0)
  isActive      Boolean      @default(true)
  isFeatured    Boolean      @default(false)

  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id])
  collectionId  String?
  collection    Collection?  @relation(fields: [collectionId], references: [id])

  tags          String[]
  images        ProductImage[]
  videos        ProductVideo[]
  variants      ProductVariant[]
  orderItems    OrderItem[]
  publications  CatalogPublication[]

  createdById   String?
  createdBy     User?        @relation("ProductCreatedBy", fields: [createdById], references: [id])

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([storeType, slug])
  @@index([storeType, isActive])
  @@map("products")
}

model ProductImage {
  id             String          @id @default(cuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Denormalized URL for fast rendering (source of truth may be assetVersion)
  url            String
  alt            String?
  order          Int             @default(0)
  isCover        Boolean         @default(false)
  /// Optional link to AI Studio asset version — files are never duplicated
  assetVersionId String?
  assetVersion   AIAssetVersion? @relation(fields: [assetVersionId], references: [id], onDelete: SetNull)

  @@index([assetVersionId])
  @@map("product_images")
}

model ProductVideo {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)

  @@map("product_videos")
}

// Handles size/color/type variants for both clothing (talla/color) and
// tattoo supplies (calibre/presentación) via a flexible attributes map.
model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String      @unique
  attributes Json        // e.g. { "size": "M", "color": "Black" } or { "gauge": "0.35mm" }
  stock      Int         @default(0)
  priceDelta Decimal     @default(0) @db.Decimal(10, 2)
  orderItems OrderItem[]

  @@map("product_variants")
}

// ------------------------------------------------------------------
// TATTOO GALLERY CONTEXT (portfolio — not for sale)
// ------------------------------------------------------------------

model GalleryAlbum {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String?
  style       String         // e.g. "Realismo", "Blackwork", "Old School"
  coverImage  String?
  isFeatured  Boolean        @default(false)
  order       Int            @default(0)
  photos      GalleryPhoto[]
  createdAt   DateTime       @default(now())

  @@map("gallery_albums")
}

model GalleryPhoto {
  id        String       @id @default(cuid())
  albumId   String
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  order     Int          @default(0)
  isCover   Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@map("gallery_photos")
}

// ------------------------------------------------------------------
// ORDERS CONTEXT (manual checkout — WhatsApp-driven fulfillment)
// ------------------------------------------------------------------

enum OrderStatus {
  NEW
  PENDING
  CONTACTED
  IN_PROGRESS
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Admin classification: cotización does not touch stock; venta deducts stock once.
enum OrderFulfillment {
  PENDING
  QUOTE
  SALE
}

model Order {
  id            String       @id @default(cuid())
  code          String       @unique // human-readable e.g. CGC-2026-0001

  customerName  String
  customerPhone String
  country       String       @default("Mexico")
  state         String
  municipality  String       @default("")
  postalCode    String       @default("")
  address       String       // calle y número
  city          String       @default("") // legacy / alias; prefer municipality
  references    String?
  comments      String?

  status        OrderStatus  @default(NEW)
  fulfillment   OrderFulfillment @default(PENDING)
  stockDeducted Boolean      @default(false)

  items         OrderItem[]
  notes         OrderNote[]

  subtotal      Decimal      @db.Decimal(10, 2)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([fulfillment])
  @@map("orders")
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  quantity    Int
  unitPrice   Decimal         @db.Decimal(10, 2)

  @@map("order_items")
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@map("order_notes")
}

// ------------------------------------------------------------------
// AI PRODUCT STUDIO CONTEXT (DAM — independent from catalog CRUD)
// ------------------------------------------------------------------

enum AIProjectStatus {
  DRAFT
  PROCESSING
  READY
  PUBLISHED
  ARCHIVED
}

enum AIAssetStatus {
  DRAFT
  PROCESSING
  READY
  PUBLISHED
  ARCHIVED
  ERROR
}

enum AIAssetType {
  ORIGINAL
  BACKGROUND_REMOVED
  WHITE_BACKGROUND
  BLACK_BACKGROUND
  PNG
  WEBP
  JPG
  MOCKUP
  STREET
  FLATLAY
  TRYON_MAN
  TRYON_WOMAN
  DETAIL
  THUMBNAIL
  PREVIEW_3D
  GLB
}

enum AIVersionJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  ERROR
}

enum CatalogPublicationStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CatalogPublishSessionStatus {
  PENDING
  CONSUMED
  EXPIRED
}

model AIProject {
  id          String          @id @default(cuid())
  name        String
  description String?
  status      AIProjectStatus @default(DRAFT)
  createdById String
  createdBy   User            @relation("AIProjectCreatedBy", fields: [createdById], references: [id])
  assets      AIAsset[]
  publications CatalogPublication[]
  publishSessions CatalogPublishSession[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, createdAt])
  @@map("ai_projects")
}

model AIAsset {
  id               String        @id @default(cuid())
  projectId        String
  project          AIProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assetType        AIAssetType   @default(ORIGINAL)
  status           AIAssetStatus @default(DRAFT)
  favorite         Boolean       @default(false)
  currentVersionId String?       @unique
  currentVersion   AIAssetVersion? @relation("AIAssetCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         AIAssetVersion[] @relation("AIAssetVersions")
  jobs             AIProcessingJob[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([projectId, status])
  @@index([projectId, favorite])
  @@map("ai_assets")
}

model AIAssetVersion {
  id              String             @id @default(cuid())
  assetId         String
  asset           AIAsset            @relation("AIAssetVersions", fields: [assetId], references: [id], onDelete: Cascade)
  versionNumber   Int
  parentVersionId String?
  parentVersion   AIAssetVersion?    @relation("AIVersionTree", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions   AIAssetVersion[]   @relation("AIVersionTree")
  processingType  AIAssetType
  storagePath     String
  mime            String
  width           Int?
  height          Int?
  size            Int?
  checksum        String?
  createdById     String?
  createdBy       User?              @relation("AIAssetVersionCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime           @default(now())
  isCurrent       Boolean            @default(false)
  isOriginal      Boolean            @default(false)
  jobStatus       AIVersionJobStatus @default(COMPLETED)
  notes           String?
  currentForAsset AIAsset?           @relation("AIAssetCurrentVersion")
  publicationLinks CatalogPublicationAsset[]
  productImages   ProductImage[]
  publishSessionItems CatalogPublishSessionItem[]

  @@unique([assetId, versionNumber])
  @@index([assetId, createdAt])
  @@map("ai_asset_versions")
}

model AIProcessingJob {
  id           String             @id @default(cuid())
  assetId      String
  asset        AIAsset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sourceVersionId String
  targetTypes  AIAssetType[]
  status       AIVersionJobStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  completedAt  DateTime?

  @@index([assetId, status])
  @@map("ai_processing_jobs")
}

model CatalogPublication {
  id          String                   @id @default(cuid())
  projectId   String
  project     AIProject                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?                 @relation(fields: [productId], references: [id], onDelete: SetNull)
  publishedAt DateTime                 @default(now())
  publishedById String
  publishedBy User                     @relation("CatalogPublicationBy", fields: [publishedById], references: [id])
  status      CatalogPublicationStatus @default(DRAFT)
  assets      CatalogPublicationAsset[]

  @@index([projectId, publishedAt])
  @@index([productId])
  @@map("catalog_publications")
}

model CatalogPublicationAsset {
  id             String             @id @default(cuid())
  publicationId  String
  publication    CatalogPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  assetVersionId String
  assetVersion   AIAssetVersion     @relation(fields: [assetVersionId], references: [id], onDelete: Restrict)
  order          Int                @default(0)

  @@unique([publicationId, assetVersionId])
  @@map("catalog_publication_assets")
}

/// Temporary bridge session: AI Studio → Product form (no product created yet)
model CatalogPublishSession {
  id          String                      @id @default(cuid())
  projectId   String
  project     AIProject                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User                        @relation("CatalogPublishSessionBy", fields: [createdById], references: [id])
  status      CatalogPublishSessionStatus @default(PENDING)
  storeType   StoreType                   @default(CLOTHING)
  expiresAt   DateTime
  createdAt   DateTime                    @default(now())
  items       CatalogPublishSessionItem[]

  @@index([createdById, status])
  @@map("catalog_publish_sessions")
}

model CatalogPublishSessionItem {
  id             String               @id @default(cuid())
  sessionId      String
  session        CatalogPublishSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assetVersionId String
  assetVersion   AIAssetVersion       @relation(fields: [assetVersionId], references: [id], onDelete: Cascade)
  order          Int                  @default(0)

  @@unique([sessionId, assetVersionId])
  @@map("catalog_publish_session_items")
}
