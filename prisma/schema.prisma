// ============================================================================
// CAPITAL GANG CLOTHING — Data Model
// Bounded contexts: Identity | Catalog (Clothing) | TattooShop | Gallery | Orders
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------
// IDENTITY CONTEXT
// ------------------------------------------------------------------

enum Role {
  ADMIN
  USER
}

model User {
  id             String    @id @default(cuid())
  firstName      String
  lastName       String
  phone          String
  email          String?   @unique
  passwordHash   String
  role           Role      @default(USER)

  // Access-code validation flow (only relevant for USER on first login)
  accessCode      String?   // hashed, used to verify first login
  /// Plaintext code for admin panel until the user finishes first login + password setup
  accessCodePlain String?
  isValidated     Boolean   @default(false)
  /// After first login with access code, user must set their own password
  mustSetPassword Boolean   @default(false)

  isActive       Boolean   @default(true)
  avatarUrl      String?
  locale         String    @default("es-MX")
  theme          String    @default("dark")

  createdById    String?
  createdBy      User?     @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers   User[]    @relation("UserCreatedBy")

  sessions       Session[]
  activityLogs   ActivityLog[]
  createdProducts Product[] @relation("ProductCreatedBy")
  handledOrders  OrderNote[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([role])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   // e.g. "product.created", "order.status_changed"
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("activity_logs")
}

// ------------------------------------------------------------------
// SHARED CATALOG PRIMITIVES (used by both Clothing & TattooShop)
// ------------------------------------------------------------------

enum StoreType {
  CLOTHING
  TATTOO_SHOP
}

model Category {
  id           String     @id @default(cuid())
  storeType    StoreType
  name         String
  slug         String
  parentId     String?
  parent       Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  subcategories Category[] @relation("CategoryParent")
  products     Product[]
  order        Int        @default(0)

  @@unique([storeType, slug])
  @@map("categories")
}

model Collection {
  id          String    @id @default(cuid())
  storeType   StoreType
  name        String
  slug        String    @unique
  description String?
  coverImage  String?
  isDrop      Boolean   @default(false)
  dropDate    DateTime?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())

  @@map("collections")
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("app_settings")
}

model Product {
  id            String       @id @default(cuid())
  storeType     StoreType
  name          String
  slug          String
  description   String
  basePrice     Decimal      @db.Decimal(10, 2)
  discountPrice Decimal?     @db.Decimal(10, 2)
  /// Available units for sale (decremented when an order is marked as SALE)
  stock         Int          @default(0)
  isActive      Boolean      @default(true)
  isFeatured    Boolean      @default(false)

  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id])
  collectionId  String?
  collection    Collection?  @relation(fields: [collectionId], references: [id])

  tags          String[]
  images        ProductImage[]
  videos        ProductVideo[]
  variants      ProductVariant[]
  orderItems    OrderItem[]

  createdById   String?
  createdBy     User?        @relation("ProductCreatedBy", fields: [createdById], references: [id])

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([storeType, slug])
  @@index([storeType, isActive])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  order     Int     @default(0)
  isCover   Boolean @default(false)

  @@map("product_images")
}

model ProductVideo {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)

  @@map("product_videos")
}

// Handles size/color/type variants for both clothing (talla/color) and
// tattoo supplies (calibre/presentación) via a flexible attributes map.
model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String      @unique
  attributes Json        // e.g. { "size": "M", "color": "Black" } or { "gauge": "0.35mm" }
  stock      Int         @default(0)
  priceDelta Decimal     @default(0) @db.Decimal(10, 2)
  orderItems OrderItem[]

  @@map("product_variants")
}

// ------------------------------------------------------------------
// TATTOO GALLERY CONTEXT (portfolio — not for sale)
// ------------------------------------------------------------------

model GalleryAlbum {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String?
  style       String         // e.g. "Realismo", "Blackwork", "Old School"
  coverImage  String?
  isFeatured  Boolean        @default(false)
  order       Int            @default(0)
  photos      GalleryPhoto[]
  createdAt   DateTime       @default(now())

  @@map("gallery_albums")
}

model GalleryPhoto {
  id        String       @id @default(cuid())
  albumId   String
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  order     Int          @default(0)
  isCover   Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@map("gallery_photos")
}

// ------------------------------------------------------------------
// ORDERS CONTEXT (manual checkout — WhatsApp-driven fulfillment)
// ------------------------------------------------------------------

enum OrderStatus {
  NEW
  PENDING
  CONTACTED
  IN_PROGRESS
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Admin classification: cotización does not touch stock; venta deducts stock once.
enum OrderFulfillment {
  PENDING
  QUOTE
  SALE
}

model Order {
  id            String       @id @default(cuid())
  code          String       @unique // human-readable e.g. CGC-2026-0001

  customerName  String
  customerPhone String
  country       String       @default("Mexico")
  state         String
  municipality  String       @default("")
  postalCode    String       @default("")
  address       String       // calle y número
  city          String       @default("") // legacy / alias; prefer municipality
  references    String?
  comments      String?

  status        OrderStatus  @default(NEW)
  fulfillment   OrderFulfillment @default(PENDING)
  stockDeducted Boolean      @default(false)

  items         OrderItem[]
  notes         OrderNote[]

  subtotal      Decimal      @db.Decimal(10, 2)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([fulfillment])
  @@map("orders")
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  quantity    Int
  unitPrice   Decimal         @db.Decimal(10, 2)

  @@map("order_items")
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@map("order_notes")
}
